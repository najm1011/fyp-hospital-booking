# =============================================================================
# Hospital Booking System - Environment Variables Template
# =============================================================================
# Project: Hospital Appointment Booking System
# Student: Najm (2356070)
# =============================================================================
# INSTRUCTIONS:
# 1. Copy this file to .env (do NOT commit .env to git)
# 2. Replace all placeholder values with actual credentials
# 3. Keep .env file secure and never share publicly
# =============================================================================

# =============================================================================
# DATABASE CONFIGURATION
# =============================================================================

# MySQL Database Host (localhost for same server, IP/domain for remote)
DB_HOST=localhost

# MySQL Database Port (default: 3306)
DB_PORT=3306

# Database Name
DB_NAME=hospital_booking

# Database Username (application user, NOT root)
DB_USERNAME=hospital_app

# Database Password (CHANGE THIS - use strong password)
DB_PASSWORD=CHANGE_ME_TO_STRONG_PASSWORD

# =============================================================================
# JWT SECURITY CONFIGURATION
# =============================================================================

# JWT Secret Key (minimum 256 bits / 32 characters)
# Generate with: openssl rand -base64 64
JWT_SECRET=CHANGE_ME_TO_RANDOM_256_BIT_SECRET_KEY

# JWT Token Expiration in milliseconds (86400000 = 24 hours)
JWT_EXPIRATION=86400000

# =============================================================================
# EMAIL CONFIGURATION (SMTP)
# =============================================================================

# SMTP Server Host
# Examples:
#   Gmail: smtp.gmail.com
#   Outlook: smtp.office365.com
#   AWS SES: email-smtp.us-east-1.amazonaws.com
#   Custom: mail.yourdomain.com
SMTP_HOST=smtp.gmail.com

# SMTP Port (587 for TLS, 465 for SSL, 25 for plain)
SMTP_PORT=587

# SMTP Username (usually your email address)
SMTP_USERNAME=noreply@yourdomain.com

# SMTP Password (or app-specific password for Gmail)
SMTP_PASSWORD=CHANGE_ME_TO_SMTP_PASSWORD

# Email sender address (appears in "From" field)
EMAIL_FROM=noreply@yourdomain.com

# =============================================================================
# CORS CONFIGURATION
# =============================================================================

# Allowed Origins (comma-separated list of frontend URLs)
# Development: http://localhost:3000,http://localhost:5173
# Production: https://yourdomain.com,https://www.yourdomain.com
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173

# =============================================================================
# FILE UPLOAD CONFIGURATION
# =============================================================================

# Upload Directory (absolute path)
# Linux/macOS: /var/www/hospital-booking/uploads/
# Windows: C:/hospital-booking/uploads/
UPLOAD_DIR=/var/www/hospital-booking/uploads/

# =============================================================================
# OPTIONAL CONFIGURATIONS
# =============================================================================

# Application Environment (development, staging, production)
APP_ENV=production

# Log Level (DEBUG, INFO, WARN, ERROR)
LOG_LEVEL=INFO

# Server Port (default: 8080)
SERVER_PORT=8080

# =============================================================================
# GMAIL CONFIGURATION NOTES
# =============================================================================
# If using Gmail SMTP:
# 1. Enable 2-factor authentication on your Google account
# 2. Generate an "App Password":
#    - Go to: https://myaccount.google.com/apppasswords
#    - Select app: Mail
#    - Select device: Other (custom name)
#    - Copy the 16-character password
# 3. Use the app password as SMTP_PASSWORD
# =============================================================================

# =============================================================================
# AWS SES CONFIGURATION NOTES
# =============================================================================
# If using AWS SES:
# 1. Create SMTP credentials in AWS SES console
# 2. Verify sender email address
# 3. Use SMTP credentials as SMTP_USERNAME and SMTP_PASSWORD
# 4. Set SMTP_HOST to your AWS region endpoint:
#    - us-east-1: email-smtp.us-east-1.amazonaws.com
#    - eu-west-1: email-smtp.eu-west-1.amazonaws.com
# =============================================================================

# =============================================================================
# SECURITY RECOMMENDATIONS
# =============================================================================
# 1. Use strong, unique passwords (minimum 16 characters)
# 2. Generate JWT secret with cryptographically secure random generator
# 3. Never commit .env file to version control
# 4. Add .env to .gitignore
# 5. Use different credentials for development and production
# 6. Rotate passwords regularly
# 7. Use environment-specific .env files (.env.dev, .env.prod)
# 8. Consider using secrets management (AWS Secrets Manager, HashiCorp Vault)
# =============================================================================

# =============================================================================
# PASSWORD GENERATION EXAMPLES
# =============================================================================
# Generate strong database password:
#   openssl rand -base64 32
#
# Generate JWT secret (256 bits):
#   openssl rand -base64 64
#
# Generate random password (macOS/Linux):
#   LC_ALL=C tr -dc 'A-Za-z0-9!@#$%^&*' < /dev/urandom | head -c 32
# =============================================================================
